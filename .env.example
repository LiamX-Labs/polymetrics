# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: PolygonScan API Key
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Optional: Allowed Telegram User IDs (comma-separated)
# Leave empty to allow all users
ALLOWED_USER_IDS=

# ==========================================
# BTC Tracker Configuration
# ==========================================

# Chat ID where tracker alerts are sent (required for live alerts)
# Example: TRACKER_TELEGRAM_CHAT_ID=-1001234567890
TRACKER_TELEGRAM_CHAT_ID=

# Tracker loop polling interval (seconds)
TRACKER_POLL_INTERVAL_SECONDS=15

# Allowed trigger drift around exact 80% trigger timestamp (seconds)
TRACKER_TRIGGER_TOLERANCE_SECONDS=20

# SQLite database path
TRACKER_DATABASE_PATH=data/tracker.sqlite3

# Daily report hour in UTC (0-23)
TRACKER_DAILY_REPORT_HOUR_UTC=23

# Safe mode: when true, prints alerts instead of sending Telegram messages
TRACKER_DRY_RUN=true

# API endpoints
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
CLOB_API_BASE_URL=https://clob.polymarket.com
